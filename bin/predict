#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");
const root = path.join(__dirname, "..", "src");
const core = require(path.join(root, "predict-core.js"));

function usage() {
  process.stderr.write(
    [
      "usage:",
      "  predict catalog build --rui DIR [--only ID ...] [--out FILE]",
      "  predict validate FILE --catalog FILE [--tree FILE]",
      "  predict signatures --catalog FILE",
      "  predict mcp --catalog FILE --state FILE",
      "  predict vendor --app DIR --rui DIR",
      "  predict check --app DIR",
      "  predict version",
      ""
    ].join("\n")
  );
  process.exit(2);
}

function flags(argv) {
  const out = { _: [], only: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--only") {
      while (i + 1 < argv.length && !argv[i + 1].startsWith("--")) out.only.push(argv[++i]);
    } else if (a.startsWith("--")) {
      if (i + 1 >= argv.length) usage();
      out[a.slice(2)] = argv[++i];
    } else {
      out._.push(a);
    }
  }
  return out;
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (error) {
    process.stderr.write(`${file}: ${error.message}\n`);
    process.exit(2);
  }
}

const [verb, ...rest] = process.argv.slice(2);

if (verb === "version") {
  process.stdout.write(`${core.VERSION}\n`);
} else if (verb === "catalog") {
  const f = flags(rest.slice(1));
  if (rest[0] !== "build" || !f.rui) usage();
  let catalog;
  try {
    catalog = require(path.join(root, "catalog.js")).build({ ruiDir: f.rui, only: f.only });
  } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exit(1);
  }
  const text = `${JSON.stringify(catalog, null, 2)}\n`;
  if (f.out) fs.writeFileSync(f.out, text);
  else process.stdout.write(text);
  if (!catalog.modules.length) process.stderr.write("empty catalog: no module provides component.mount\n");
} else if (verb === "validate") {
  const f = flags(rest);
  if (!f._[0] || !f.catalog) usage();
  const result = core.validate(readJson(f._[0]), readJson(f.catalog), f.tree ? readJson(f.tree) : null);
  if (result.ok) {
    process.stdout.write(`${JSON.stringify({ ok: true, tree: result.tree }, null, 2)}\n`);
  } else {
    process.stdout.write(`${JSON.stringify({ ok: false, errors: result.errors }, null, 2)}\n`);
    process.exit(1);
  }
} else if (verb === "signatures") {
  const f = flags(rest);
  if (!f.catalog) usage();
  process.stdout.write(`${core.signatures(readJson(f.catalog))}\n`);
} else if (verb === "mcp") {
  const f = flags(rest);
  if (!f.catalog || !f.state) usage();
  require(path.join(root, "mcp.js")).run({ catalog: f.catalog, state: f.state });
} else if (verb === "vendor") {
  const f = flags(rest);
  if (!f.app || !f.rui) usage();
  try {
    const out = require(path.join(root, "vendor.js")).vendor({ app: f.app, ruiDir: f.rui });
    process.stdout.write(`${JSON.stringify({ ok: true, modules: out.modules, files: out.lock.files.length })}\n`);
  } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exit(1);
  }
} else if (verb === "check") {
  const f = flags(rest);
  if (!f.app) usage();
  const out = require(path.join(root, "vendor.js")).check({ app: f.app });
  process.stdout.write(`${JSON.stringify(out)}\n`);
  if (!out.ok) process.exit(1);
} else {
  usage();
}
